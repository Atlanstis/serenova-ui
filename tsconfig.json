{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "vite.config.ts"],
  "exclude": [
    "src/**/*.stories.*",
    "src/**/*.spec.*",
    "src/**/*.test.*",
    ".storybook/**",
    "tests/**"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  }
}

{
  "name": "serenova-ui",
  "version": "0.0.0",
  "private": false,
  "description": "面向 Vue 3 的 TypeScript UI 组件库。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atlanstis/serenova-ui.git"
  },
  "homepage": "https://github.com/Atlanstis/serenova-ui#readme",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "component-library",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/serenova-ui.cjs",
  "module": "./dist/serenova-ui.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/serenova-ui.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/serenova-ui.js",
      "require": "./dist/serenova-ui.cjs"
    },
    "./style.css": "./dist/serenova-ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "pnpm type-check:lib && vite build && vue-tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:dist": "pnpm build && SERENOVA_STORYBOOK_MODE=dist storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "build:storybook:dist": "pnpm build && SERENOVA_STORYBOOK_MODE=dist storybook build -o storybook-static-dist",
    "dev": "pnpm storybook",
    "dev:dist": "pnpm storybook:dist",
    "type-check": "pnpm type-check:lib && pnpm type-check:storybook && pnpm type-check:test",
    "type-check:lib": "vue-tsc --noEmit -p tsconfig.json",
    "type-check:storybook": "vue-tsc --noEmit -p tsconfig.storybook.json",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:preview": "playwright test --config playwright.config.ts tests/preview",
    "test:visual": "playwright test --config playwright.config.ts tests/visual",
    "test:package": "node tests/package/package-smoke.mjs",
    "quality": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test:unit && pnpm test:browser && pnpm test:e2e && pnpm build:storybook && pnpm build:storybook:dist && pnpm test:package",
    "pack:check": "pnpm build && npm pack --dry-run",
    "publish:dry-run": "npm publish --dry-run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm type-check && pnpm format:check && pnpm test:unit",
    "prepublishOnly": "pnpm quality",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-themes": "10.5.10",
    "@storybook/vue3-vite": "10.5.10",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue": "^3.5.42",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}

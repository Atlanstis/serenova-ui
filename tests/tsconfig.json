{
  "extends": "../tsconfig.json",
  "include": [
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../src/**/*.vue",
    "./**/*.ts",
    "./**/*.vue",
    "../vite.config.ts",
    "../vitest.config.ts",
    "../playwright.config.ts"
  ],
  "exclude": [
    "../src/**/*.stories.*",
    "../src/**/*.spec.*",
    "../src/**/*.test.*",
    "./contracts/package/**"
  ],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["../src/*"],
      "serenova-ui": ["../src/index.ts"],
      "serenova-ui/button": ["../src/components/button/index.ts"],
      "serenova-ui/theme-provider": ["../src/components/theme-provider/index.ts"],
      "serenova-ui/themes/light": ["../src/theme/presets/light.ts"],
      "serenova-ui/themes/dark": ["../src/theme/presets/dark.ts"]
    }
  }
}

{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts",
    "tests/**/*.vue",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "dist/**",
    "node_modules/**",
    ".storybook/**",
    "src/**/*.stories.*",
    "tests/package/**"
  ],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"]
  }
}

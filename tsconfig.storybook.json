{
  "extends": "./tsconfig.json",
  "include": [".storybook/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/*.spec.*", "src/**/*.test.*"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "serenova-ui": ["./src/index.ts"],
      "serenova-ui/style.css": ["./src/styles/index.css"]
    }
  }
}

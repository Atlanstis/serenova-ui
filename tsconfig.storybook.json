{
  "extends": "./tsconfig.json",
  "include": [".storybook/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/*.spec.*", "src/**/*.test.*"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "serenova-ui": ["./src/index.ts"],
      "serenova-ui/button": ["./src/components/button/index.ts"],
      "serenova-ui/theme-provider": ["./src/components/theme-provider/index.ts"],
      "serenova-ui/themes/light": ["./src/theme/presets/light.ts"],
      "serenova-ui/icons": ["./src/components/icon/index.ts"]
    }
  }
}
